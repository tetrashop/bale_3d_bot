{
  "version": 2,
  "functions": {
    "app.py": {
      "runtime": "python3.9"
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/app.py"
    },
    {
      "src": "/api/convert",
      "dest": "/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
